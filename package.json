{
  "name": "windrow",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:server": "node --test server/server.test.mjs",
    "test:e2e": "tsx e2e/m1.ts",
    "test:e2e:m2": "tsx e2e/m2.ts",
    "test:e2e:m3": "tsx e2e/m3.ts",
    "test:e2e:io": "tsx e2e/io.ts",
    "test:e2e:sync": "tsx e2e/sync.ts",
    "test:e2e:all": "tsx e2e/m1.ts && tsx e2e/m2.ts && tsx e2e/io.ts && tsx e2e/m3.ts && tsx e2e/sync.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@scure/bip39": "1.5.4",
    "clsx": "^2.1.1",
    "dexie": "^4.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.0",
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.52.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
