# Copy to .env and fill in. .env is gitignored — never commit a real secret.
#
# Generate the pairing secret with:
#   openssl rand -base64 32
#
# This is the value you paste into the extension when pairing a device. Anyone
# holding it can pair a new device to your instance, so treat it as a password.

TABBARY_PAIRING_SECRET=replace-me-with-openssl-rand-base64-32

# Where the SQLite file lives inside the container. Match the volume mount in
# compose.yaml; do not point this at a path that is not persisted.
TABBARY_DB=/data/tabbary.db

# Pairing attempts per IP per minute.
TABBARY_PAIR_LIMIT=5
